#!/bin/sh
case $BUTTON in
    1) pactl set-sink-volume @DEFAULT_SINK@ +5% ;;
    3) pactl set-sink-volume @DEFAULT_SINK@ -5% ;;
    4) pactl set-sink-volume @DEFAULT_SINK@ +1% ;;
    5) pactl set-sink-volume @DEFAULT_SINK@ -1% ;;
    2) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
esac
VOL=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+%' | head -1)
MUTE=$(pactl get-sink-mute @DEFAULT_SINK@ | grep -oP 'yes|no')
if [ "$MUTE" = "yes" ]; then
    echo "MUTE"
else
    echo "$VOL"
fi
