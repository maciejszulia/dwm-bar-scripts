#!/usr/bin/env python3
"""Printable power report for the house and the campsite: charts as inline SVG in
one HTML page, then a PDF through headless Chromium. Numbers come from `energy`
itself, so the report and the bar never disagree. Grayscale with a hatch for the
campsite, because the printer is a mono laser.

  energy-charts OUT_DIR    writes OUT_DIR/report.html and OUT_DIR/report.pdf
"""
import html
import math
import importlib.machinery
import os
import subprocess
import sys
from collections import defaultdict
from datetime import date, datetime, timedelta

E = importlib.machinery.SourceFileLoader("energy", os.path.join(os.path.dirname(os.path.realpath(__file__)), "energy")).load_module()
INK, MUTED, GRID = "#1a1a1a", "#555", "#d0d0d0"
FILL = {"house": "#3a3a3a", "camp": "url(#hatch)"}
NAME = {"house": "dom", "camp": "kemping"}
MONTHS = "sty lut mar kwi maj cze lip sie wrz paź lis gru".split()
DEFS = ('<defs><pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">'
        '<rect width="6" height="6" fill="#bdbdbd"/><line x1="0" y1="0" x2="0" y2="6" stroke="#6a6a6a" stroke-width="2"/>'
        '</pattern></defs>')


def legend(x, y):
    out = ""
    for i, s in enumerate(("house", "camp")):
        out += (f'<rect x="{x + i * 110}" y="{y - 10}" width="14" height="12" rx="2" fill="{FILL[s]}"/>'
                f'<text x="{x + i * 110 + 20}" y="{y}" font-size="12" fill="{INK}">{NAME[s]}</text>')
    return out


def axis(x0, y0, w, h, top, unit, ticks=4):
    out = ""
    for i in range(ticks + 1):
        v = top * i / ticks
        y = y0 - h * i / ticks
        out += (f'<line x1="{x0}" x2="{x0 + w}" y1="{y:.1f}" y2="{y:.1f}" stroke="{GRID}" stroke-width="1"/>'
                f'<text x="{x0 - 6}" y="{y + 4:.1f}" font-size="10" fill="{MUTED}" text-anchor="end">{v:,.0f}</text>')
    return out + f'<text x="{x0 - 6}" y="{y0 - h - 10}" font-size="10" fill="{MUTED}" text-anchor="end">{unit}</text>'


def nice(v):
    """Smallest 1, 2, 2.5 or 5 times a power of ten that is >= v."""
    mag = 10 ** math.floor(math.log10(v)) if v > 0 else 1
    return next(k * mag for k in (1, 2, 2.5, 5, 10) if k * mag >= v)


def stacked_bars(rows, unit, title, W=720, H=260):
    """rows: [(label, house, camp)] -> stacked bars, house at the baseline."""
    x0, y0, w, h = 56, H - 34, W - 70, H - 80
    top = nice(max(a + b for _, a, b in rows) * 1.08)
    bw = w / len(rows)
    out = f'<svg viewBox="0 0 {W} {H}" width="100%">{DEFS}<text x="0" y="16" font-size="14" font-weight="600" fill="{INK}">{html.escape(title)}</text>'
    out += legend(W - 230, 16) + axis(x0, y0, w, h, top, unit)
    for i, (lab, a, b) in enumerate(rows):
        x = x0 + i * bw + bw * 0.18
        ha, hb = h * a / top, h * b / top
        out += f'<rect x="{x:.1f}" y="{y0 - ha:.1f}" width="{bw * 0.64:.1f}" height="{ha:.1f}" fill="{FILL["house"]}"/>'
        out += f'<rect x="{x:.1f}" y="{y0 - ha - hb:.1f}" width="{bw * 0.64:.1f}" height="{max(hb - 2, 0):.1f}" rx="2" fill="{FILL["camp"]}"/>'
        out += f'<text x="{x + bw * 0.32:.1f}" y="{y0 - ha - hb - 4:.1f}" font-size="9" fill="{INK}" text-anchor="middle">{a + b:,.0f}</text>'
        out += f'<text x="{x + bw * 0.32:.1f}" y="{y0 + 14}" font-size="10" fill="{MUTED}" text-anchor="middle">{lab}</text>'
    return out + "</svg>"


def lines(series, unit, title, gaps=(), W=720, H=240):
    """series: {site: [(date, value)]} daily lines; gaps: dates shaded as SUPLA outages."""
    x0, y0, w, h = 56, H - 34, W - 120, H - 80
    alld = sorted({d for s in series.values() for d, _ in s})
    top = nice(max(v for s in series.values() for _, v in s) * 1.08)
    X = lambda d: x0 + w * (d - alld[0]).days / max((alld[-1] - alld[0]).days, 1)
    out = f'<svg viewBox="0 0 {W} {H}" width="100%">{DEFS}<text x="0" y="16" font-size="14" font-weight="600" fill="{INK}">{html.escape(title)}</text>'
    out += axis(x0, y0, w, h, top, unit)
    for d in gaps:
        out += f'<rect x="{X(d) - 3:.1f}" y="{y0 - h}" width="6" height="{h}" fill="#ececec"/>'
    style = {"house": ("#1a1a1a", ""), "camp": ("#1a1a1a", ' stroke-dasharray="5 3"')}
    for s, pts in series.items():
        col, dash = style[s]
        path = " ".join(f"{'M' if i == 0 else 'L'}{X(d):.1f},{y0 - h * v / top:.1f}" for i, (d, v) in enumerate(pts))
        out += f'<path d="{path}" fill="none" stroke="{col}" stroke-width="2"{dash}/>'
        d, v = pts[-1]
        out += f'<text x="{X(d) + 4:.1f}" y="{y0 - h * v / top + 4:.1f}" font-size="11" fill="{INK}">{NAME[s]}</text>'
    for d in alld:
        if d.day == 1:
            out += f'<text x="{X(d):.1f}" y="{y0 + 14}" font-size="10" fill="{MUTED}" text-anchor="middle">1 {MONTHS[d.month - 1]}</text>'
    return out + "</svg>"


def scatter(points, r2, title, W=350, H=250):
    x0, y0, w, h = 46, H - 34, W - 60, H - 96
    xmax = nice(max(x for x, _ in points) + 1)
    top = nice(max(y for _, y in points) * 1.08)
    out = f'<svg viewBox="0 0 {W} {H}" width="100%"><text x="0" y="16" font-size="13" font-weight="600" fill="{INK}">{html.escape(title)}</text>'
    out += f'<text x="0" y="32" font-size="11" fill="{MUTED}">R² = {r2:.2f}: temperatura nie tłumaczy zużycia</text>'
    out += axis(x0, y0, w, h, top, "kWh", ticks=5)
    for x, y in points:
        out += f'<circle cx="{x0 + w * x / xmax:.1f}" cy="{y0 - h * y / top:.1f}" r="2.2" fill="#555" fill-opacity="0.55"/>'
    out += f'<text x="{x0 + w}" y="{y0 + 26}" font-size="10" fill="{MUTED}" text-anchor="end">stopniodni (15,5 °C − średnia temperatura doby)</text>'
    for i in range(6):
        out += f'<text x="{x0 + w * i / 5:.1f}" y="{y0 + 14}" font-size="10" fill="{MUTED}" text-anchor="middle">{xmax * i / 5:.0f}</text>'
    return out + "</svg>"


def main(out_dir):
    today = date.today()
    usage, camp, temps = E.load("daily.json", {"days": {}}), E.load("camp.json", {"days": {}}), E.load("temps.json", {"t": {}})
    meter = {date.fromisoformat(k): v for k, v in usage["days"].items()}
    cdays = {date.fromisoformat(k): v for k, v in camp["days"].items()}
    t = {date.fromisoformat(k): v for k, v in temps["t"].items()}
    m = E.compute(today)
    sites = E.split(meter, cdays)
    year_kwh = m["year_kwh"]
    first = min(cdays) if cdays else today
    months = defaultdict(lambda: {"house": [0, 0], "camp": [0, 0]})
    for s in ("house", "camp"):
        for d, v in sites[s].items():
            if d > first:  # before SUPLA the split is unknown
                months[(d.year, d.month)][s][0] += v[0] + v[1]
                months[(d.year, d.month)][s][1] += E.day_cost(v[0], v[1], d, year_kwh, v[3])
    keys = [k for k in sorted(months) if k > (first.year, first.month)][-14:]  # the first SUPLA month is partial
    lab = lambda k: f"{MONTHS[k[1] - 1]}{'' if k[1] != 1 else ' ' + str(k[0])[2:]}"
    kwh_rows = [(lab(k), months[k]["house"][0], months[k]["camp"][0]) for k in keys]
    zl_rows = [(lab(k), months[k]["house"][1], months[k]["camp"][1]) for k in keys]
    d90 = [today - timedelta(days=i) for i in range(90, 0, -1)]
    daily = {s: [(d, sum(sites[s][d][:2])) for d in d90 if d in sites[s]] for s in ("house", "camp")}
    gaps = [d for d in d90 if d not in cdays or cdays[d][2] < 1410]
    sc = {s: [(E.hdd(t[d]), v[0] + v[1]) for d, v in sites[s].items() if v[2] and d in t and today - timedelta(days=365) <= d < today]
          for s in ("house", "camp")}
    fc = {s: m["sites"][s].get("forecast") for s in ("house", "camp")}

    p = {s: m["sites"][s]["periods"] for s in E.SITES}
    names = {"today": datetime.now().strftime("dziś – %d.%m.%Y, %H:%M"), "week": "ten tydzień", "month": "ten miesiąc", "year": "ten rok"}
    table = "".join(f"<tr><td>{names[k]}</td>" + "".join(f"<td>{p[s][k]['kwh']:,.1f} kWh<br><b>{p[s][k]['zl']:,.2f} zł</b></td>" for s in E.SITES) + "</tr>"
                    for k in names)
    ftable = "".join(f"<tr><td>następne {n} dni</td>" + "".join(
        f"<td>{fc[s][f'{n}d']['kwh']:,.0f} kWh<br><b>{fc[s][f'{n}d']['zl']:,.0f} zł</b> ±{fc[s][f'{n}d']['band_zl']:,.0f}</td>" if fc[s] else "<td>—</td>"
        for s in ("house", "camp")) + "</tr>" for n in (7, 30))
    camp_share = p["camp"]["year"]["kwh"] / p["all"]["year"]["kwh"] * 100 if p["all"]["year"]["kwh"] else 0
    night = [v for d, v in cdays.items() if today - timedelta(days=30) <= d < today and v[2] >= 1410]
    camp_base = sum(v[0] + v[1] for v in night) / len(night) if night else 0
    full_nov = sum(1 for d, v in cdays.items() if d.year == today.year and d.month == today.month and v[2] >= 1410)
    z2 = {s: p[s]["year"]["z2"] / p[s]["year"]["kwh"] * 100 if p[s]["year"]["kwh"] else 0 for s in ("house", "camp")}
    insights = [
        f"Kemping zużył w tym roku {camp_share:.0f} % prądu z licznika ({p['camp']['year']['kwh']:,.0f} z {p['all']['year']['kwh']:,.0f} kWh) "
        f"i kosztował {p['camp']['year']['zl']:,.0f} zł; dom {p['house']['year']['zl']:,.0f} zł.",
        f"Kemping poza sezonem pobiera średnio {camp_base:.0f} kWh na dobę (ostatnie 30 dni, tylko pełne doby SUPLA), "
        f"czyli ok. {camp_base * 30 * ((1 - z2['camp'] / 100) * E.ZONE_PRICE[0] + z2['camp'] / 100 * E.ZONE_PRICE[1]):,.0f} zł miesięcznie (ceny z obu stref według udziału kempingu). Pobór idzie głównie fazą 1 i trwa także w nocy "
        "(0,7–1,2 kWh na godzinę). Dużą część tego poboru robi całoroczny lokator (szkutnik, licznik analogowy za SUPLA): "
        "od 24.10 do 27.11 zużył 573 kWh z 1014 kWh kempingu; faza 1 ma oprócz niego innych odbiorców.",
        "Temperatura nie tłumaczy zużycia ani domu, ani kempingu (R² 0,00), więc prognoza to w praktyce średnia z roku; "
        "dokładniejsza byłaby prognoza z ostatnich 4 tygodni z podziałem na dni robocze i wolne.",
        f"Strefa 2 (tańsza o 0,70 zł/kWh) to {z2['house']:.0f} % zużycia domu i {z2['camp']:.0f} % zużycia kempingu; "
        "każda kWh przeniesiona na 13:00–15:00, 22:00–06:00 albo na weekend oszczędza 0,70 zł.",
        "Przekładnik prądowy fazy 1 w liczniku SUPLA jest założony odwrotnie (pobór liczy się jako oddawanie, także w nocy); "
        "program to koryguje, ale po montażu fotowoltaiki na kempingu trzeba go przełożyć.",
        f"SUPLA traci łączność: w tym miesiącu ma pełne dane tylko z {full_nov} dób; energię z przerw program rozkłada równo "
        "(szare pasy na wykresie dziennym).",
    ]
    mod = {s: m["sites"][s].get("model", {}) for s in ("house", "camp")}
    doc = f"""<!doctype html><html lang="pl"><meta charset="utf-8"><title>Prąd: dom i kemping</title>
<style>
@page {{ size: A4; margin: 14mm; }}
body {{ font-family: "JetBrains Mono", "DejaVu Sans", sans-serif; color: {INK}; background: #fff; font-size: 11px; margin: 0; }}
h1 {{ font-size: 20px; margin: 0 0 2px; }} h2 {{ font-size: 13px; margin: 14px 0 4px; }}
.sub {{ color: {MUTED}; margin-bottom: 8px; }}
table {{ border-collapse: collapse; width: 100%; margin: 4px 0 8px; }}
td, th {{ border-bottom: 1px solid {GRID}; padding: 4px 6px; text-align: right; vertical-align: top; }}
td:first-child, th:first-child {{ text-align: left; }}
.page {{ break-after: page; }} .two {{ display: flex; gap: 12px; }} .two > div {{ flex: 1; }}
li {{ margin-bottom: 5px; line-height: 1.35; }}
</style>
<div class="page">
<h1>Prąd: dom i kemping</h1>
<div class="sub">Stan na {today:%d.%m.%Y}, licznik Energa do {m.get('last_hour') or '—'}; taryfa G12w; kwoty brutto z opłatami stałymi podzielonymi według kWh każdego dnia.
Kemping mierzy podlicznik SUPLA, dom = licznik Energa − kemping.</div>
<table><tr><th></th><th>razem (dom + kemping)</th><th>dom</th><th>kemping</th></tr>{table}</table>
{stacked_bars(kwh_rows, "kWh", "Zużycie miesięczne (kWh)")}
{stacked_bars(zl_rows, "zł", "Koszt miesięczny (zł brutto)")}
<h2>Spostrzeżenia</h2><ol>{''.join(f'<li>{html.escape(x)}</li>' for x in insights)}</ol>
</div>
<div>
{lines(daily, "kWh", "Zużycie dzienne, ostatnie 90 dni (kemping linią przerywaną)", gaps)}
<div class="two"><div>{scatter(sc['house'], mod['house'].get('r2', 0), "Dom: zużycie a temperatura")}</div>
<div>{scatter(sc['camp'], mod['camp'].get('r2', 0), "Kemping: zużycie a temperatura")}</div></div>
<h2>Prognoza</h2><table><tr><th></th><th>dom</th><th>kemping</th></tr>{ftable}</table>
<h2>Cena 1 kWh (brutto)</h2><table>
<tr><td>strefa 1 (dzienna)</td><td>{E.ZONE_PRICE[0]:.4f} zł</td></tr><tr><td>strefa 2 (nocna i weekend)</td><td>{E.ZONE_PRICE[1]:.4f} zł</td></tr>
<tr><td>opłaty stałe licznika</td><td>{sum(E.MONTHLY.values()) + E.capacity_fee(year_kwh):.2f} zł/mies.</td></tr></table>
<div class="sub">Źródła: Mój Licznik (Energa-Operator), SUPLA Cloud, Open-Meteo; cennik standardowy Energa-Obrót i stawki Energa-Operator od 1.02.2026.</div>
</div></html>"""
    os.makedirs(out_dir, exist_ok=True)
    page = os.path.join(out_dir, "report.html")
    with open(page, "w") as f:
        f.write(doc)
    pdf = os.path.join(out_dir, "report.pdf")
    subprocess.run(["chromium", "--headless", "--disable-gpu", "--no-pdf-header-footer", f"--print-to-pdf={pdf}",
                    "file://" + os.path.abspath(page)], check=True, capture_output=True, timeout=120)
    print(pdf)


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    main(sys.argv[1])
