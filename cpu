#!/bin/sh
# Blok CPU na pasku dwm (jak `gpu`): temperatura pakietu i obciążenie od poprzedniego wywołania
# (delta /proc/stat — pierwsza klatka `top -bn1` pokazuje średnią od startu systemu, nie bieżącą),
# do tego wiatrak: poziom EC i obroty z /proc/acpi/ibm/fan. Kółko/LPM = poziom wyżej, PPM = niżej, po
# disengaged (max) wraca auto; zapis do pliku `manual` serwisu `wiatrak`, który traktuje go jako minimum
# nad krzywą temperatury — więc z paska nie da się udusić chłodzenia. EC zna tylko poziomy, nie RPM.
S=${XDG_RUNTIME_DIR:-/tmp}/cpu-block.stat
MANUAL=$HOME/.local/state/wiatrak/manual
LEVELS='auto 3 4 5 6 7 disengaged'
case ${BUTTON:-} in
1|3|4|5)
	m=$(head -1 "$MANUAL" 2>/dev/null); i=1; n=0
	for l in $LEVELS; do n=$((n + 1)); [ "$l" = "$m" ] && i=$n; done
	case $BUTTON in 1|4) i=$(( i % 7 + 1 )) ;; *) i=$(( (i + 5) % 7 + 1 )) ;; esac
	set -- $LEVELS; eval "echo \${$i}" > "$MANUAL"
	;;
esac
t=$(( $(cat "$(grep -l x86_pkg_temp /sys/class/thermal/thermal_zone*/type | sed 's/type$/temp/')") / 1000 ))
read -r _ u n s i w q sq _ < /proc/stat
idle=$((i + w)); total=$((u + n + s + i + w + q + sq)); util=0
if [ -r "$S" ] && read -r p_idle p_total < "$S"; then
	d=$((total - p_total)); [ "$d" -gt 0 ] && util=$(( 100 * (d - (idle - p_idle)) / d ))
fi
echo "$idle $total" > "$S"
ghz=$(awk '{s+=$1; n++} END {printf "%.1f", s/n/1e6}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq)
fan=$(awk '/^speed:/ {r=$2} /^level:/ {l=$2} END {sub("disengaged","max",l); if (r != "") printf " %s:%drpm", l, r}' /proc/acpi/ibm/fan 2>/dev/null)
printf '%d°C %d%% %sGHz%s\n' "$t" "$util" "$ghz" "$fan"
